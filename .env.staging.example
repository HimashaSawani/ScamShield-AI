SCAMSHIELD_IMAGE=scamshield:REPLACE_WITH_TESTED_RELEASE_TAG
SCAMSHIELD_DOMAIN=staging.example.com
POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_URL_SAFE_PASSWORD
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_FROM=scamshield@example.com
SMTP_USER=REPLACE_ME
SMTP_PASSWORD=REPLACE_ME
RETENTION_DAYS=90
# Optional trusted data-only model bundle mounted read-only at /models.
# Empty means rules-only. Pin the SHA256 of the reviewed manifest to activate.
SCAMSHIELD_MODEL_DIR=
SCAMSHIELD_MODEL_MANIFEST_SHA256=
