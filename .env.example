# Template environment variables. Never enable DEV_EMAIL_TOKENS in a public or staging deployment.
DATABASE_URL=sqlite:///./scamshield.db
STORAGE_PATH=./storage
# Safe default (disabled). Set DEV_EMAIL_TOKENS=1 only in local development when SMTP is not configured.
DEV_EMAIL_TOKENS=0
OCR_LANGUAGES=eng+sin+tam
RETENTION_DAYS=90
# Optional integrity-pinned data-only ML bundle (enables scamshield-url-v1; text model remains disabled by quality gate):
# SCAMSHIELD_MODEL_DIR=./ml/artifacts/v1-json
# SCAMSHIELD_MODEL_MANIFEST_SHA256=833de7d2d619c033da5fbb71d266793861e498ef5cbcd592a283df843c6ff5a9
# Set SMTP_HOST and disable DEV_EMAIL_TOKENS for staging/production.
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_FROM=scamshield@example.com
# SMTP_TLS=1
# SMTP_USER=
# SMTP_PASSWORD=
