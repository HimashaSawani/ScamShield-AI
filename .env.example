# Template environment variables. Never enable DEV_EMAIL_TOKENS in a public or staging deployment.
DATABASE_URL=sqlite:///./scamshield.db
STORAGE_PATH=./storage
# Safe default (disabled). Set DEV_EMAIL_TOKENS=1 only in local development when SMTP is not configured.
DEV_EMAIL_TOKENS=0
OCR_LANGUAGES=eng+sin+tam
RETENTION_DAYS=90
# Optional integrity-pinned data-only ML bundle (enables scamshield-url-v2; text model remains disabled by quality gate):
# SCAMSHIELD_MODEL_DIR=./ml/artifacts/v2-json
# SCAMSHIELD_MODEL_MANIFEST_SHA256=b9c99c7e5bc4e003357748dd343ca5f9e44fc9c24f03c611f77e4d342ca33606
# Set SMTP_HOST and disable DEV_EMAIL_TOKENS for staging/production.
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_FROM=scamshield@example.com
# SMTP_TLS=1
# SMTP_USER=
# SMTP_PASSWORD=
