# Local development only. Never enable development tokens in a public deployment.
DATABASE_URL=sqlite:///./scamshield.db
STORAGE_PATH=./storage
DEV_EMAIL_TOKENS=1
OCR_LANGUAGES=eng+sin+tam
RETENTION_DAYS=90
# Set SMTP_HOST and disable DEV_EMAIL_TOKENS for staging/production.
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_FROM=scamshield@example.com
# SMTP_TLS=1
# SMTP_USER=
# SMTP_PASSWORD=
