# ScamShield AI Mobile Environment Configuration

# 1. Android Emulator (default: 10.0.2.2 maps to host 127.0.0.1)
EXPO_PUBLIC_API_URL=http://10.0.2.2:8015/api

# 2. Physical Android Phone (same Wi-Fi network; replace with computer LAN IP)
# EXPO_PUBLIC_API_URL=http://192.168.1.6:8015/api

# 3. Hosted Environment (Production / Staging HTTPS)
# EXPO_PUBLIC_API_URL=https://api.scamshield.example.com/api
